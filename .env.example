# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
PORT=8080

BETTER_AUTH_SECRET="replace-me"
BETTER_AUTH_URL="https://localhost:8080"
CORS_ORIGIN="https://localhost:3000,https://localhost:4000"

# Optional. `pnpm start:dev` generates and uses certs/dev-*.pem automatically.
# SSL_KEY_PATH=certs/dev-key.pem
# SSL_CERT_PATH=certs/dev-cert.pem
